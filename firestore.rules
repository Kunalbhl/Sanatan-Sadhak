rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SuperUser';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      // Profiles hold email/mobile/city: only the owner and admins can read them.
      allow read: if isOwner(userId) || isAdmin();
      // Users create their own profile but can never give themselves a role; admins can.
      allow create: if (isOwner(userId) && (!('role' in request.resource.data) || request.resource.data.role == 'Regular')) || isAdmin();
      allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) || isAdmin();
      allow delete: if isAdmin();
    }

    // Community Posts collection
    match /community_posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if (isAuthenticated() && resource.data.author == request.resource.data.author) || isAdmin();
      allow delete: if (isAuthenticated() && resource.data.author == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email) || isAdmin();
    }
    
    // Community Comments
    match /community_comments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if (isAuthenticated() && resource.data.author == request.resource.data.author) || isAdmin();
      allow delete: if (isAuthenticated() && resource.data.author == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email) || isAdmin();
    }

    // Audit Logs
    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // ---- Website forms (sanatan-sadhak.chaloone.com) ----
    // Anyone may CREATE a validated document; nobody can read, change or delete from the
    // site. Admins read them in the console or the app's admin panel.
    function validEmail(e) {
      return e is string && e.size() <= 200 && e.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$');
    }
    function optStr(d, k, max) {
      return !(k in d) || (d[k] is string && d[k].size() <= max);
    }
    function siteMeta(d) {
      return d.source == 'website' && d.page is string && d.page.size() <= 100
        && d.createdAt == request.time;
    }

    match /early_access/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'city', 'interest', 'consent', 'source', 'page', 'createdAt'])
        && validEmail(request.resource.data.email)
        && request.resource.data.consent == true
        && optStr(request.resource.data, 'name', 100)
        && optStr(request.resource.data, 'city', 100)
        && optStr(request.resource.data, 'interest', 60)
        && siteMeta(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    match /deletion_requests/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'scope', 'reason', 'status', 'source', 'page', 'createdAt'])
        && validEmail(request.resource.data.email)
        && request.resource.data.scope in ['account', 'data_only']
        && request.resource.data.status == 'pending'
        && optStr(request.resource.data, 'name', 100)
        && optStr(request.resource.data, 'reason', 1000)
        && siteMeta(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    match /contact_messages/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'topic', 'message', 'source', 'page', 'createdAt'])
        && validEmail(request.resource.data.email)
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 5 && request.resource.data.message.size() <= 2000
        && optStr(request.resource.data, 'name', 100)
        && optStr(request.resource.data, 'topic', 40)
        && siteMeta(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    match /suggestions/{id} {
      allow create: if request.resource.data.keys().hasOnly(['type', 'message', 'screen', 'consent', 'name', 'email', 'source', 'page', 'createdAt'])
        && request.resource.data.type in ['idea', 'bug', 'feedback']
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 5 && request.resource.data.message.size() <= 2000
        && request.resource.data.consent is bool
        && optStr(request.resource.data, 'screen', 60)
        && optStr(request.resource.data, 'name', 100)
        && (!('email' in request.resource.data) || validEmail(request.resource.data.email))
        && siteMeta(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    // Public release notes (admin-written, readable by anyone)
    // YouTube channels shown in the app's video library (managed in the admin panel)
    match /youtube_channels/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Videos an admin hid from the app's video library
    match /hidden_videos/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /app_updates/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- Contributor roles & approval workflow ----
    // An admin grants Contributor/Moderator by email. Contributions stay private (author + reviewers)
    // until a Moderator/admin sets status to 'approved'; only approved ones are readable by everyone.
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function roleOf() {
      return get(/databases/$(database)/documents/roles/$(myEmail())).data.role;
    }
    function hasRoleDoc() {
      return isAuthenticated() && request.auth.token.email != null
        && exists(/databases/$(database)/documents/roles/$(myEmail()));
    }
    function isModerator() {
      return isAdmin() || (hasRoleDoc() && roleOf() == 'Moderator');
    }
    function isContributor() {
      return isModerator() || (hasRoleDoc() && roleOf() == 'Contributor');
    }

    match /roles/{email} {
      allow get: if isAdmin() || (isAuthenticated() && request.auth.token.email != null && email == myEmail());
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    match /role_requests/{email} {
      allow create, update: if isAuthenticated() && request.auth.token.email != null && email == myEmail()
        && request.resource.data.keys().hasOnly(['email', 'name', 'note', 'status', 'createdAt'])
        && request.resource.data.email == myEmail()
        && request.resource.data.status == 'pending'
        && request.resource.data.note.size() <= 500;
      allow read: if isAdmin() || (isAuthenticated() && request.auth.token.email != null && email == myEmail());
      allow delete: if isAdmin() || (isAuthenticated() && request.auth.token.email != null && email == myEmail());
    }

    match /contributions/{id} {
      allow read: if resource.data.status == 'approved'
        || isModerator()
        || (isAuthenticated() && request.auth.token.email != null && resource.data.authorEmail == myEmail());
      allow create: if isContributor()
        && request.resource.data.keys().hasOnly(['title', 'category', 'body', 'sourceUrl', 'authorEmail', 'authorName', 'status', 'createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.authorEmail == myEmail()
        && request.resource.data.title is string && request.resource.data.title.size() >= 3 && request.resource.data.title.size() <= 150
        && request.resource.data.body is string && request.resource.data.body.size() >= 50 && request.resource.data.body.size() <= 8000;
      // Reviewers change only the review fields, and nobody but an admin approves their own submission.
      allow update: if isModerator()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewNote', 'reviewedAt'])
        && request.resource.data.status in ['approved', 'rejected', 'pending']
        && (resource.data.authorEmail != myEmail() || isAdmin());
      allow delete: if isModerator()
        || (isAuthenticated() && request.auth.token.email != null && resource.data.authorEmail == myEmail() && resource.data.status == 'pending');
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
